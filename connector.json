{
  "id": "shopify",
  "name": "Shopify",
  "version": "0.1.0",
  "baseUrl": "https://{SHOPIFY_STORE}.myshopify.com/admin/api/2026-10",
  "auth": {
    "type": "header",
    "env": "SHOPIFY_ACCESS_TOKEN",
    "header": "X-Shopify-Access-Token"
  },
  "tools": [
    {
      "name": "shopify_list_products",
      "description": "Read a bounded product page using a fixed Admin GraphQL query.",
      "method": "POST",
      "path": "/graphql.json",
      "readOnly": true,
      "approvalRequired": false,
      "inputSchema": {
        "type": "object",
        "properties": {
          "first": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "after": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "first"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "first": "variables.first",
          "after": "variables.after"
        }
      },
      "sampleArguments": {
        "first": 5
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "body": {
        "query": "query FactoryProducts($first: Int!, $after: String) { products(first: $first, after: $after) { nodes { id title status } pageInfo { hasNextPage endCursor } } }"
      },
      "provenance": [
        "https://shopify.dev/docs/api/admin-graphql/2026-10/queries/products",
        "https://shopify.dev/docs/api/admin-graphql/2026-10/mutations/productUpdate",
        "https://shopify.dev/docs/apps/build/graphql"
      ]
    },
    {
      "name": "shopify_update_product_title",
      "description": "Update only the chosen product title. Requires write_products scope; inspect returned userErrors.",
      "method": "POST",
      "path": "/graphql.json",
      "readOnly": false,
      "approvalRequired": true,
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^gid://shopify/Product/[0-9]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false
      },
      "bindings": {
        "path": [],
        "query": {},
        "body": {
          "id": "variables.product.id",
          "title": "variables.product.title"
        }
      },
      "sampleArguments": {
        "id": "gid://shopify/Product/1000000001",
        "title": "Sandbox product"
      },
      "evidence": {
        "state": "documented",
        "providerLiveValidation": "not-run"
      },
      "body": {
        "query": "mutation FactoryProductTitle($product: ProductUpdateInput!) { productUpdate(product: $product) { product { id title } userErrors { field message } } }"
      },
      "provenance": [
        "https://shopify.dev/docs/api/admin-graphql/2026-10/queries/products",
        "https://shopify.dev/docs/api/admin-graphql/2026-10/mutations/productUpdate",
        "https://shopify.dev/docs/apps/build/graphql"
      ]
    }
  ],
  "workflow": {
    "name": "Shopify authorized workflow",
    "description": "Inspect store products, then explicitly approve a title change to one chosen product.",
    "steps": [
      "shopify_list_products",
      "shopify_update_product_title"
    ]
  },
  "provenance": [
    "https://shopify.dev/docs/api/admin-graphql/2026-10/queries/products",
